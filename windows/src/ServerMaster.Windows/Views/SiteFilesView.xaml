<UserControl
    x:Class="ServerMaster.Windows.Views.SiteFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="FileRow">
            <Grid Padding="0,7" ColumnSpacing="10" DoubleTapped="Entry_DoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Glyph}" FontSize="15" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding Name}" Click="Entry_Click"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Padding="2,4" FontFamily="Consolas" ToolTipService.ToolTip="{Binding FullPath}" />
                <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding ModifiedLabel}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="4" Content="Edit" IsEnabled="{Binding CanEdit}" Click="Edit_Click" Padding="10,3" VerticalAlignment="Center" />
                <Button Grid.Column="5" Click="Menu_Click" Padding="6" VerticalAlignment="Center" ToolTipService.ToolTip="File actions" AutomationProperties.Name="File actions">
                    <SymbolIcon Symbol="More" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Files" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="The hidden ones, and the ones worth editing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshFilesCommand}" VerticalAlignment="Center" AutomationProperties.Name="Refresh files"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Refresh" /></StackPanel></Button>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MaxWidth="320" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding FilesProfile, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" AutomationProperties.Name="Profile" />
                <Button Grid.Column="2" Content="Show in Explorer" Command="{Binding OpenFilesFolderCommand}" />
            </Grid>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <BreadcrumbBar x:Name="Breadcrumbs" ItemClicked="Breadcrumb_Click" />
                <TextBlock Grid.Row="1" Text="{Binding FilesPath}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            </Grid>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="{Binding FilesProblem}" Visibility="{Binding FilesProblemVisibility}" />
            <Border Style="{StaticResource PanelBorderStyle}" Padding="24" Visibility="{Binding FilesEmptyVisibility}">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="This folder is empty" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Add site files here or choose another profile." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelBorderStyle}" Padding="15" Visibility="{Binding HiddenFilesVisibility}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Hidden and config files" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding HiddenFileEntries}" ItemTemplate="{StaticResource FileRow}" />
                </StackPanel>
            </Border>
            <Expander Header="{Binding AllFilesToggleText}" IsExpanded="{Binding ShowAllFiles, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding VisibleFileEntries}" ItemTemplate="{StaticResource FileRow}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>

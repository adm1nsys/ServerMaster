                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Starting and stopping" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="Open the browser after start (all profiles)" IsChecked="{Binding OpenBrowserOnStart, Mode=TwoWay}" /><CheckBox Content="Keep running in the notification area when the window is closed" IsChecked="{Binding KeepRunningInNotificationArea, Mode=TwoWay}" ToolTipService.ToolTip="Servers keep running while ServerMaster stays in the notification area. Quit always stops them and releases their ports." /><CheckBox Content="Ask for confirmation before stopping" IsChecked="{Binding ConfirmBeforeStop, Mode=TwoWay}" /><CheckBox Content="Restart automatically after a crash" IsChecked="{Binding RestartOnCrash, Mode=TwoWay}" /><CheckBox Content="Check whether the port is free before starting" IsChecked="{Binding CheckPortBeforeStart, Mode=TwoWay}" /><CheckBox Content="Free the port automatically if it is taken" IsChecked="{Binding KillPortOccupantOnStart, Mode=TwoWay}" IsEnabled="{Binding CheckPortBeforeStart}" /><TextBlock Text="The app will end whichever process holds the port. Be careful with system services." Visibility="{Binding KillPortWarningVisibility}" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18"><StackPanel Spacing="10"><TextBlock Text="Console" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="Scroll to new output" IsChecked="{Binding AutoScrollConsole, Mode=TwoWay}" /><CheckBox Content="Write server logs to disk" IsChecked="{Binding WriteLogsToFile, Mode=TwoWay}" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox Header="Console buffer lines" Value="{Binding ConsoleBufferLines, Mode=TwoWay}" Minimum="100" Maximum="50000" /><NumberBox Grid.Column="1" Header="Font size" Value="{Binding ConsoleFontSize, Mode=TwoWay}" Minimum="9" Maximum="24" /><NumberBox Grid.Column="2" Header="Log retention days" Value="{Binding LogRetentionDays, Mode=TwoWay}" Minimum="0" Maximum="365" /></Grid><ComboBox Header="Default terminal" SelectedValuePath="Tag" SelectedValue="{Binding DefaultTerminalShell, Mode=TwoWay}" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="PowerShell" Tag="PowerShell" /><ComboBoxItem Content="Command Prompt" Tag="CMD" /></ComboBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open logs folder" Click="OpenLogsFolder_Click" /><Button Content="Clear old logs" Click="ClearOldLogs_Click" /></StackPanel></StackPanel></Border>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18"><StackPanel Spacing="12"><TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" /><CheckBox Content="Moving background" IsChecked="{Binding BackgroundEnabled, Mode=TwoWay}" /><TextBlock Text="A mesh of colour behind every screen. Running profiles can tint the window with their accent colour." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBlock Text="Colour" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BackgroundHue, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="Hue" VerticalAlignment="Center" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBlock Text="Speed" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="3" Value="{Binding BackgroundSpeed, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="Animation" VerticalAlignment="Center" /></Grid><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBlock Text="Colour amount" VerticalAlignment="Center" /><Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BackgroundSaturation, Mode=TwoWay}" /><TextBlock Grid.Column="2" Text="Saturation" VerticalAlignment="Center" /></Grid><CheckBox Content="Take the colour from running servers" IsChecked="{Binding BackgroundFollowsServers, Mode=TwoWay}" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock Text="Sidebar" VerticalAlignment="Center" /><ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding SidebarStyle, Mode=TwoWay}"><ComboBoxItem Content="Standard" Tag="standard" /><ComboBoxItem Content="Updated" Tag="modern" /></ComboBox></Grid></StackPanel></Border>

                                                <TextBlock Grid.Column="1" Text="{Binding TablesLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="Open" Command="{Binding DataContext.OpenDatabaseBrowserCommand, ElementName=Shell}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="3" Content="Structure" Command="{Binding DataContext.OpenDatabaseStructureCommand, ElementName=Shell}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="4" Content="Accounts" Command="{Binding DataContext.OpenDatabaseAccountsCommand, ElementName=Shell}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="5" Content="Snapshot" Command="{Binding DataContext.CreateDatabaseBackupCommand, ElementName=Shell}" CommandParameter="{Binding}" />
                                                <Button Grid.Column="6" Content="Copy name" Command="{Binding DataContext.CopyDatabaseValueCommand, ElementName=Shell}" CommandParameter="{Binding Name}" />
                                                <Button Grid.Column="7" Content="Credentials" Click="DatabaseCredentials_Click" />
                                                <Button Grid.Column="8" Content="Delete" Command="{Binding DataContext.DeleteDatabaseCommand, ElementName=Shell}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox PlaceholderText="database name" Text="{Binding NewDatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" PlaceholderText="user" Text="{Binding NewDatabaseUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <PasswordBox Grid.Column="2" PlaceholderText="password" Password="{Binding NewDatabasePassword, Mode=TwoWay}" />
                                    <Button Grid.Column="3" Content="Create" Command="{Binding CreateDatabaseCommand}" IsEnabled="{Binding DatabaseCanStop}" />
                                    <Button Grid.Column="4" Content="Import..." Click="ImportDatabase_Click" IsEnabled="{Binding DatabaseCanStop}" />
                                </Grid>
                                <TextBlock Text="Import a SQL dump or an archive containing one. Enter the target database name first. User and password are needed only when creating a new database." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="The password is stored in the database and ends up in your site config. Fine for a local setup, not for production." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>


                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Database log" FontSize="18" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{Binding DatabaseLogToggleText}" Command="{Binding ToggleDatabaseLogCommand}" /><Button Grid.Column="2" Content="Clear" Command="{Binding ClearDatabaseLogCommand}" /></Grid>
                                <TextBlock Text="Everything the database reports about itself, including why it crashed." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Border Background="{StaticResource ServerMasterPanelSubtleBrush}" Padding="10" Height="{Binding DatabaseLogHeight}">
                                    <ListView ItemsSource="{Binding DatabaseLogLines}" Background="Transparent" BorderThickness="0">
                                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18" Visibility="{Binding DatabaseInstallVisibility}">
                            <StackPanel Spacing="10"><TextBlock Text="MariaDB is not installed" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Install MariaDB from the dependency manager, then return here to start the local database." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Install" Command="{Binding InstallDatabaseCommand}" /><Button Content="Dependencies" Command="{Binding ShowDependenciesCommand}" /></StackPanel></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Visibility="{Binding PortsVisibility}" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ports" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PortsSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding CanRefreshPorts}" VerticalAlignment="Top" AutomationProperties.Name="Refresh ports">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Refresh" /></StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Width="240" PlaceholderText="Port, process, PID" Text="{Binding PortSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="UDP" IsChecked="{Binding PortsIncludeUdp, Mode=TwoWay}" VerticalAlignment="Center" />
                        <CheckBox Content="System" IsChecked="{Binding PortsShowSystemProcesses, Mode=TwoWay}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding PortReservationsVisibility}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Reservation" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Width="90" PlaceholderText="port" Text="{Binding ReservePortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Port to reserve" />
                            <TextBox Width="220" PlaceholderText="why" Text="{Binding ReservePortNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reservation note" />
                            <Button Content="Reserve" Command="{Binding ReservePortCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PortReservations}">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="13" /><TextBlock Text="{Binding Display}" VerticalAlignment="Center" /><Button Content="Release" Command="{Binding DataContext.ReleasePortCommand, ElementName=Shell}" CommandParameter="{Binding}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="10">
                        <Grid>
                        <ListView ItemsSource="{Binding PortEntries}" SelectionMode="None" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,10" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Port}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Protocol}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayAddress}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Description}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="4" Click="OpenPort_Click" IsEnabled="{Binding CanOpenInBrowser}" ToolTipService.ToolTip="Open in browser" AutomationProperties.Name="Open port">
                                            <SymbolIcon Symbol="Globe" />
                                        </Button>
                                        <Button Grid.Column="5" Click="PortDetails_Click" ToolTipService.ToolTip="Process details" AutomationProperties.Name="Process details">
                                            <FontIcon Glyph="&#xE946;" FontSize="15" />
                                        </Button>
                                        <Button Grid.Column="6" Click="TerminatePort_Click" IsEnabled="{Binding CanTerminate}" ToolTipService.ToolTip="Terminate process" AutomationProperties.Name="Terminate process">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ProgressRing Width="28" Height="28" IsActive="True" Visibility="{Binding PortsProgressVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Message="{Binding PortsProblem}" Visibility="{Binding PortsProblemVisibility}" VerticalAlignment="Top" Margin="8" />
                        <StackPanel Visibility="{Binding PortsEmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="No matching ports" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Change the filters or refresh the list." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding DependenciesVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Dependencies" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="What each configuration needs in order to start" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding DependenciesProgressVisibility}" AutomationProperties.Name="Checking dependencies" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CheckDependenciesCommand}" IsEnabled="{Binding CanCheckDependencies}" VerticalAlignment="Top" AutomationProperties.Name="Check all">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                                <TextBlock Text="Check all" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" RowSpacing="18" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="220" /></Grid.RowDefinitions>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="10">
                            <ListView ItemsSource="{Binding Dependencies}" Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Dependency.Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Dependency.Summary}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Version}" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayMessage}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RemovalBlockedReason}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AvailableVersion}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                    <Button Content="Check for update" Click="DependencyUpdateCheck_Click" IsEnabled="{Binding CanAct}" Visibility="{Binding UpdateCheckVisibility}" />
                                                    <Button Content="Versions..." Click="DependencyVersions_Click" IsEnabled="{Binding CanAct}" Visibility="{Binding VersionSelectionVisibility}" />
                                                    <Button Content="Update" Click="DependencyUpdate_Click" IsEnabled="{Binding CanAct}" Visibility="{Binding UpdateActionVisibility}" />
                                                </StackPanel>
                                                <ProgressBar Visibility="{Binding ActivityVisibility}" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding Progress}" Maximum="100" />
                                                <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Visibility="{Binding ErrorVisibility}" Message="{Binding Error}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Click="DependencyAction_Click" IsEnabled="{Binding CanAct}" MinWidth="88" Content="{Binding ActionText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PanelBorderStyle}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Install log" FontWeight="SemiBold" />
                                </StackPanel>
                                <ListView Grid.Row="1" ItemsSource="{Binding DependencyLogLines}" Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Row="1" Visibility="{Binding DiagnosticsVisibility}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Mac layout: title on the left, "Check again" at the top right. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Diagnostics" FontSize="32" FontWeight="SemiBold" />
                                <TextBlock Text="What is wrong when everything looks installed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RunDiagnosticsCommand}" IsEnabled="{Binding CanRunDiagnostics}" VerticalAlignment="Top" AutomationProperties.Name="Run diagnostics">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Check again" /></StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding CopyDiagnosticsCommand}" IsEnabled="{Binding CanCopyDiagnostics}" AutomationProperties.Name="Copy report">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8C8;" FontSize="12" /><TextBlock Text="Copy report" /></StackPanel>
                            </Button>
                            <Button Command="{Binding ShowDependenciesCommand}" AutomationProperties.Name="Dependencies">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE9D9;" FontSize="12" /><TextBlock Text="Dependencies" /></StackPanel>
                            </Button>
                            <Button Command="{Binding ShowProfilesCommand}" AutomationProperties.Name="Profiles">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8FD;" FontSize="12" /><TextBlock Text="Profiles" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding DiagnosticsProgressVisibility}" />
                        <Border Style="{StaticResource PanelBorderStyle}" Padding="15">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding DiagnosticsGlyph}" Foreground="{Binding DiagnosticsTint}" FontSize="28" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding DiagnosticsSummary}" FontSize="18" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DiagnosticsCheckedAt}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Padding="15">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Trace" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Follow an address from the name to the answer. Each profile is traced on its own — two of them on the same host fail in different places." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="No profiles yet." Visibility="{Binding TraceProfilesEmptyVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding Profiles}" IsEnabled="{Binding CanTrace}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Trace" Click="TraceProfile_Click" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding TraceSubject}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding TraceProgressVisibility}" />
                                <ItemsControl ItemsSource="{Binding TraceSteps}" ItemTemplate="{StaticResource DiagnosticRow}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}" Padding="15" Visibility="{Binding DiagnosticProblemsVisibility}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Needs attention" FontSize="18" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding DiagnosticProblems}" ItemTemplate="{StaticResource DiagnosticRow}" />
                            </StackPanel>
                        </Border>
                        <Expander Header="{Binding DiagnosticHealthyHeader}" AutomationProperties.Name="{Binding DiagnosticHealthyHeader}" IsExpanded="{Binding ShowHealthyDiagnostics, Mode=TwoWay}" IsEnabled="{Binding HasHealthyDiagnostics}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding DiagnosticHealthy}" ItemTemplate="{StaticResource DiagnosticRow}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Visibility="{Binding ConsoleVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ItemsControl ItemsSource="{Binding ConsoleTabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,6,0">
                                                <ToggleButton Click="ConsoleTab_Click" DoubleTapped="ConsoleTab_DoubleTapped" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
                                                    <ToggleButton.ContextFlyout>
                                                        <MenuFlyout Opening="ConsoleTabMenu_Opening">
                                                            <MenuFlyoutItem Text="Rename" Click="RenameConsoleTab_Click" />
                                                            <MenuFlyoutItem Text="Restart shell" Click="RestartConsoleTab_Click" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Close" Click="CloseConsoleTab_Click" />
                                                        </MenuFlyout>
                                                    </ToggleButton.ContextFlyout>
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StateTint}" Visibility="{Binding StateVisibility}" VerticalAlignment="Center" />
                                                        <FontIcon Glyph="{Binding Glyph}" FontSize="12" Visibility="{Binding CloseVisibility}" />
                                                        <TextBlock Text="{Binding Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <Button Padding="6,4" Visibility="{Binding StopVisibility}" Command="{Binding DataContext.StartStopProfileCommand, ElementName=Root}" CommandParameter="{Binding Profile}" ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop">
                                                    <FontIcon Glyph="&#xE71A;" FontSize="10" />
                                                </Button>
                                                <Button Padding="6,4" Visibility="{Binding CloseVisibility}" Command="{Binding DataContext.CloseConsoleTabCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTipService.ToolTip="Close tab" AutomationProperties.Name="{Binding CloseName}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Click="NewTerminalTab_Click" ToolTipService.ToolTip="New terminal tab" AutomationProperties.Name="New terminal tab">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="12,8" Margin="0,10,0,0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ConsoleStatusText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Visibility="{Binding ConsoleServerActiveVisibility}" Command="{Binding StartStopProfileCommand}" CommandParameter="{Binding ConsoleProfile}" AutomationProperties.Name="Stop"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE71A;" FontSize="12" /><TextBlock Text="Stop" /></StackPanel></Button>
                                <Button Visibility="{Binding ConsoleServerActiveVisibility}" Command="{Binding RestartProfileCommand}" CommandParameter="{Binding ConsoleProfile}" AutomationProperties.Name="Restart"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Restart" /></StackPanel></Button>
                                <Button Style="{ThemeResource AccentButtonStyle}" Visibility="{Binding ConsoleServerStartVisibility}" Command="{Binding StartStopProfileCommand}" CommandParameter="{Binding ConsoleProfile}" AutomationProperties.Name="Start"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" FontSize="12" /><TextBlock Text="Start" /></StackPanel></Button>
                                <Button Visibility="{Binding ConsoleServerOpenVisibility}" Command="{Binding OpenProfileCommand}" CommandParameter="{Binding ConsoleProfile}" AutomationProperties.Name="Open"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE774;" FontSize="12" /><TextBlock Text="Open" /></StackPanel></Button>
                                <Button Visibility="{Binding TerminalRunningVisibility}" Click="InterruptTerminal_Click" ToolTipService.ToolTip="Send Ctrl+C to the running command" AutomationProperties.Name="Interrupt"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE769;" FontSize="12" /><TextBlock Text="Interrupt" /></StackPanel></Button>
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding TerminalStoppedVisibility}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="Orange" />
                                    <TextBlock Text="Shell stopped" FontSize="12" Foreground="Orange" />
                                </StackPanel>
                                <Button Visibility="{Binding ConsoleTerminalVisibility}" Click="RestartTerminal_Click" AutomationProperties.Name="Restart"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Restart" /></StackPanel></Button>
                            </StackPanel>
                            <TextBox Grid.Column="2" Width="160" PlaceholderText="Filter" Text="{Binding ConsoleFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ConsoleServerVisibility}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding ConsoleLineCountText}" FontSize="11" Visibility="{Binding ConsoleServerVisibility}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <DropDownButton Grid.Column="4" Content="Actions" VerticalAlignment="Center">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="ConsoleActionsMenu" Placement="BottomEdgeAlignedRight" Opening="ConsoleActionsMenu_Opening">
                                        <MenuFlyoutItem Text="Clear" Click="ConsoleClear_Click" />
                                        <MenuFlyoutItem Text="Copy all" Click="ConsoleCopyAll_Click" />
                                        <MenuFlyoutItem Text="Save to file…" Click="ConsoleSave_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Open external terminal" Click="ConsoleExternalTerminal_Click" />
                                        <MenuFlyoutItem Text="Logs folder" Click="ConsoleLogsFolder_Click" />
                                        <MenuFlyoutItem x:Name="ConsoleRevealLogItem" Text="Show the log file" Click="ConsoleRevealLog_Click" />
                                        <MenuFlyoutSeparator x:Name="ConsoleTerminalSeparator" />
                                        <MenuFlyoutItem x:Name="ConsoleProfileRootItem" Text="Go to the profile root" Click="ConsoleProfileRoot_Click" />
                                        <MenuFlyoutItem x:Name="ConsoleRestartShellItem" Text="Restart shell" Click="RestartTerminal_Click" />
                                        <MenuFlyoutItem x:Name="ConsoleRenameTabItem" Text="Rename tab" Click="RenameSelectedConsoleTab_Click" />
                                        <MenuFlyoutItem x:Name="ConsoleNewTabItem" Text="New tab" Click="NewTerminalTab_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="12" Margin="0,12,0,12" Visibility="{Binding ConsoleServerVisibility}">
                        <ListView x:Name="ServerLogList" ItemsSource="{Binding ConsoleDisplayLines}" Background="Transparent" BorderThickness="0" FontSize="{Binding ConsoleFontSize}" ContainerContentChanging="ServerLogList_ContainerContentChanging" SelectionMode="Extended">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Border Grid.Row="2" Grid.RowSpan="2" Style="{StaticResource PanelBorderStyle}" Padding="0" Margin="0,12,0,0" Visibility="{Binding ConsoleTerminalVisibility}">
                        <TextBox x:Name="TerminalSurface" Text="{Binding SelectedConsoleTab.TerminalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="{Binding ConsoleFontSize}" AcceptsReturn="True"
                                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" Padding="14"
                                 PreviewKeyDown="TerminalSurface_KeyDown" TextChanged="TerminalSurface_TextChanged" />
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <Grid Visibility="{Binding SplashVisibility}" Background="Transparent">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36" CornerRadius="18"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppLogo.png" Width="104" Height="104" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="ServerMaster" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SplashVersionLine}" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <ProgressBar Value="{Binding BootstrapProgress}" Maximum="100" Width="220" />
                        <TextBlock Text="{Binding BootstrapStage}" FontSize="12" Height="16" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding ShutdownVisibility}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="380" Padding="16">
                <Image Source="ms-appx:///Assets/AppLogo.png" Width="84" Height="84" />
                <StackPanel Spacing="6">
                    <TextBlock Text="Shutting down" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Stopping the servers so they do not linger in the system." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressBar Value="{Binding ShutdownProgress}" Maximum="100" Width="280" />
                <Border Visibility="{Binding ShutdownItemsVisibility}" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ItemsControl ItemsSource="{Binding ShutdownItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="320" ColumnSpacing="8" Padding="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Tint}" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <StackPanel x:Name="ForceQuitPanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="The server is taking longer than usual to respond." FontSize="12" Foreground="Orange" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Force quit" HorizontalAlignment="Center" Click="ForceQuit_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

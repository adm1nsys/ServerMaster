                                    <TextBlock Text="{Binding AdminerStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Address" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding AdminerAddress}" FontFamily="Cascadia Mono, Consolas" /><Button Grid.Column="2" Content="Copy" Command="{Binding CopyDatabaseValueCommand}" CommandParameter="{Binding AdminerAddress}" /></Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Databases" FontSize="18" FontWeight="SemiBold" /><Button Grid.Column="1" Content="All snapshots" Command="{Binding ShowBackupsCommand}" /></Grid>

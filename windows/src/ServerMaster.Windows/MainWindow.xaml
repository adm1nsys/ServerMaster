                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Socket" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="TCP only on Windows" FontFamily="Cascadia Mono, Consolas" /></Grid>
                                <TextBlock Text="Port 3307 speaks the MySQL protocol, not HTTP. A browser cannot open it." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Web admin panel" FontSize="18" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding AdminPanelTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /></Grid>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ServerMaster.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:ServerMaster.Windows.Views"
    mc:Ignorable="d"
    Title="ServerMaster">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="DiagnosticRow">
                <Grid ColumnSpacing="10" Padding="0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Tint}" FontSize="16" VerticalAlignment="Top" Margin="0,3,0,0" />
                    <StackPanel Grid.Column="1" Spacing="5">
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Group}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding Tint}" />
                        <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{Binding Remedy}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <!-- Apple Music style moving colour behind everything, like the Mac AmbientBackground. -->
        <views:AmbientBackground x:Name="Ambient" />
        <NavigationView
            x:Name="Shell"
            Visibility="{Binding ShellVisibility}"
            Background="Transparent"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="224"
            SelectionChanged="Shell_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Server" />
                <NavigationViewItem Content="Control" Tag="Control">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Console" Tag="Console">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Database" Tag="Database">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ports" Tag="Ports">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Files" Tag="Files">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Configuration" />
                <NavigationViewItem Content="Profiles" Tag="Profiles">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dependencies" Tag="Dependencies">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Backups" Tag="Backups">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="Diagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <!-- Compact like the Mac sidebar footer: Guides, status and Quit as three small rows,
                     so every section stays visible at the minimum window height. -->
                <StackPanel Padding="10,6,10,10" Spacing="2" BorderBrush="{StaticResource ServerMasterCardStrokeBrush}" BorderThickness="0,1,0,0">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,4" Command="{Binding OpenUrlCommand}" CommandParameter="https://adm1nsys.github.io/ServerMaster/wiki.html" AutomationProperties.Name="Guides">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE82D;" FontSize="12" />
                            <TextBlock Text="Guides" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Grid ColumnSpacing="8" Padding="8,4" ToolTipService.ToolTip="{Binding ActiveStatusSubtitle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="{Binding ActiveStatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ActiveStatusTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ActiveStatusSubtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,4" Command="{Binding QuitCommand}" AutomationProperties.Name="Quit">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7E8;" FontSize="12" />
                            <TextBlock Text="Quit" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid Padding="36,30,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8" Margin="0,0,0,18">
                    <Border Visibility="{Binding UpdateBannerVisibility}" Padding="14,10" CornerRadius="8"
                            Background="{StaticResource ServerMasterPanelSubtleBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateBannerTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UpdateBannerMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding UpdateBannerActionText}" Click="OpenAvailableUpdate_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="Later" Click="DismissAvailableUpdate_Click" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Click="DismissAvailableUpdate_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Hide until the next version" AutomationProperties.Name="Hide update">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                    <InfoBar
                        IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                        Message="{Binding BannerText}"
                        Severity="{Binding BannerSeverity}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Visibility="{Binding ControlVisibility}">
                    <StackPanel Spacing="22" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding SectionTitle}" FontSize="32" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ControlSubtitle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                <Button Command="{Binding StopAllCommand}" Visibility="{Binding StopAllVisibility}" AutomationProperties.Name="Stop all">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Stop all" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ShowConsoleCommand}" AutomationProperties.Name="Console">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Console" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource MetricBorderStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE945;" Foreground="{Binding ActiveStatusBrush}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding ActiveCount}" FontSize="20" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                        <TextBlock Text="running" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricBorderStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8FD;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Profiles.Count}" FontSize="20" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                        <TextBlock Text="profiles" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MetricBorderStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE916;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="20" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding LongestUptime}" FontSize="20" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                        <TextBlock Text="longest run" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding OpenAllProfilesCommand}" IsEnabled="{Binding CanOpenAllProfiles}" AutomationProperties.Name="Open all">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="{Binding CanOpenAllProfiles, Converter={StaticResource EnabledOpacity}}" /><TextBlock Text="Open all" /></StackPanel>
                            </Button>
                            <Button Command="{Binding CopyAddressesCommand}" IsEnabled="{Binding CanCopyAddresses}" AutomationProperties.Name="Copy addresses">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="{Binding CanCopyAddresses, Converter={StaticResource EnabledOpacity}}" /><TextBlock Text="Copy addresses" /></StackPanel>
                            </Button>
                            <Button Command="{Binding HealthCheckCommand}" IsEnabled="{Binding CanHealthCheck}" AutomationProperties.Name="Health check">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE95E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="{Binding CanHealthCheck, Converter={StaticResource EnabledOpacity}}" /><TextBlock Text="Health check" /></StackPanel>
                            </Button>
                            <Button Click="NewProfile_Click" AutomationProperties.Name="New profile">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="New profile" /></StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="15" Visibility="{Binding HealthPanelVisibility}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Health check" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ProgressRing Grid.Column="1" IsActive="True" Width="18" Height="18" Visibility="{Binding HealthProgressVisibility}" />
                                    <TextBlock Grid.Column="2" Text="{Binding HealthLastRun}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="3" Content="Clear" Command="{Binding ClearHealthCheckCommand}" IsEnabled="{Binding CanClearHealthCheck}" />
                                </Grid>
                                <TextBlock Text="{Binding HealthSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding HealthResults}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid ColumnSpacing="10" Padding="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Tint}" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Address}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="{Binding Tint}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Summary}" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="8">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="15" Visibility="{Binding ControlProfilesEmptyVisibility}">
                                <TextBlock Text="No profiles yet." VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Create" Click="NewProfile_Click" />
                            </StackPanel>
                            <ListView x:Name="ControlProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" SelectionChanged="Profiles_SelectionChanged" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,9" RightTapped="ControlProfile_RightTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding StateTint}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <Grid ColumnSpacing="5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <FontIcon Grid.Column="1" Glyph="{Binding DefaultGlyph}" FontSize="12" Foreground="#E7BD57" ToolTipService.ToolTip="Default profile" />
                                                    <FontIcon Grid.Column="2" Glyph="{Binding AdministratorGlyph}" FontSize="12" ToolTipService.ToolTip="Starts with administrator rights" />
                                                </Grid>
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding EngineTitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="-" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Address}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TransitionText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Uptime}" FontFamily="Cascadia Mono, Consolas" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                                <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" />
                                                <Button MinWidth="34" Click="ProfileOpen_Click" Visibility="{Binding RunningVisibility}" ToolTipService.ToolTip="Open site" AutomationProperties.Name="Open site">
                                                    <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Button>
                                                <Button MinWidth="34" Click="ProfileLogs_Click" ToolTipService.ToolTip="Show log" AutomationProperties.Name="Show log">
                                                    <FontIcon Glyph="&#xE8E4;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Button>
                                                <Button MinWidth="34" Click="ProfileRestart_Click" Visibility="{Binding RunningVisibility}" ToolTipService.ToolTip="Restart" AutomationProperties.Name="Restart server">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Button>
                                                <Button MinWidth="96" Click="ProfilePrimary_Click" IsEnabled="{Binding CanToggle}" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="{Binding PrimaryActionText}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="{Binding PrimaryActionGlyph}" FontSize="11" /><TextBlock Text="{Binding PrimaryActionText}" /></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="15" Visibility="{Binding SelectedProfileIssueVisibility}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="8" Visibility="{Binding SelectedProfileFailureVisibility}">
                                    <TextBlock Text="The last start failed" FontWeight="SemiBold" Foreground="#E66A72" />
                                    <TextBlock Text="{Binding SelectedProfileIssue}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button Content="What does this mean?" HorizontalAlignment="Left" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding SelectedProfileGuideUrl}" />
                                </StackPanel>
                                <StackPanel Spacing="8" Visibility="{Binding SelectedProfilePreflightVisibility}">
                                    <TextBlock Text="Worth checking before start" FontWeight="SemiBold" Foreground="#E7BD57" />
                                    <ItemsControl ItemsSource="{Binding SelectedProfilePreflightIssues}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,3" />
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="To dependencies" Command="{Binding ShowDependenciesCommand}" />
                                        <Button Content="Configure" Command="{Binding ShowProfilesCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="15" Visibility="{Binding SelectedProfileDetailsVisibility}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="9" Height="9" Fill="{Binding SelectedProfileStateBrush}" VerticalAlignment="Center" />
                                        <FontIcon Glyph="{Binding SelectedProfile.Symbol}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="15" />
                                        <TextBlock Text="{Binding SelectedProfileName}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding ShowProfilesCommand}" Content="Configure" />
                                </Grid>

                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Engine" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfileEngine}" />
                                </Grid>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Address" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfileAddress}" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
                                </Grid>
                                <Grid ColumnSpacing="12" Padding="0,6" Visibility="{Binding SelectedProfileUrlsVisibility}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Available at" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedProfileUrls}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Open" Click="DetectedUrlOpen_Click" />
                                            <Button Grid.Column="2" Click="DetectedUrlCopy_Click" ToolTipService.ToolTip="Copy address" AutomationProperties.Name="Copy address"><SymbolIcon Symbol="Copy" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Button>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Grid>
                                <Grid ColumnSpacing="12" Padding="0,6" Visibility="{Binding SelectedProfileRootVisibility}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Root" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfileRoot}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button Grid.Column="2" Command="{Binding OpenSelectedRootCommand}" ToolTipService.ToolTip="Show in Explorer" AutomationProperties.Name="Show root folder"><SymbolIcon Symbol="Folder" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Button>
                                </Grid>
                                <Grid ColumnSpacing="12" Padding="0,6" Visibility="{Binding SelectedProfilePidVisibility}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="PID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfilePid}" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
                                </Grid>
                                <Grid ColumnSpacing="12" Padding="0,6" Visibility="{Binding SelectedProfileCommandVisibility}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Command" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfileCommand}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button Grid.Column="2" Command="{Binding CopyDatabaseValueCommand}" CommandParameter="{Binding SelectedProfileCommand}" ToolTipService.ToolTip="Copy command" AutomationProperties.Name="Copy command"><SymbolIcon Symbol="Copy" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" Visibility="{Binding ProfilesVisibility}">
                    <StackPanel Spacing="22" MaxWidth="1120" HorizontalAlignment="Center">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Profiles" FontSize="32" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedProfileSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                <Button Click="NewProfile_Click" Content="New" />
                                <Button Command="{Binding DuplicateProfileCommand}" Content="Duplicate" />
                                <Button Command="{Binding DeleteProfileCommand}" Content="Delete" />
                                <Button Command="{Binding SaveProfilesCommand}" Content="Save" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="14">
                                <!-- No template picker here: New opens the template gallery (as on macOS);
                                     a second picker here made you choose the template twice. -->

                                <Border Style="{StaticResource PanelBorderStyle}" Padding="8">
                                    <ListView ItemsSource="{Binding Profiles}" SelectionChanged="Profiles_SelectionChanged" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,9" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding Symbol}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Address}" Style="{ThemeResource CaptionTextBlockStyle}" FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Padding="18" Visibility="{Binding ProfilesEditorVisibility}">
                                <StackPanel Spacing="16" DataContext="{Binding SelectedProfile}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Button Click="RenameProfile_Click" ToolTipService.ToolTip="Rename and change icon" AutomationProperties.Name="Rename and change icon">
                                                <FontIcon Glyph="{Binding Symbol}" FontSize="20" />
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="Rename..." Click="RenameProfile_Click" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Default" Visibility="{Binding DataContext.SelectedProfileDefaultVisibility, ElementName=Root}" VerticalAlignment="Center" />
                                            <Button Content="Make default" Visibility="{Binding DataContext.SelectedProfileMakeDefaultVisibility, ElementName=Root}"
                                                    Command="{Binding DataContext.MakeDefaultProfileCommand, ElementName=Root}" />
                                            <Button Content="{Binding PrimaryActionText}" Command="{Binding DataContext.StartStopProfileCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DataContext.SelectedProfileSetupMessage, ElementName=Root}" TextWrapping="Wrap" />
                                    <Button Content="Install missing software" Command="{Binding DataContext.PrepareProfileCommand, ElementName=Root}" Visibility="{Binding DataContext.SelectedProfilePrepareVisibility, ElementName=Root}" HorizontalAlignment="Left" />

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="General" FontSize="17" FontWeight="SemiBold" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Engine" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="Guide" Command="{Binding DataContext.OpenUrlCommand, ElementName=Root}"
                                                        CommandParameter="{Binding DataContext.SelectedProfileGuideUrl, ElementName=Root}" />
                                            </Grid>
                                            <ComboBox
                                                ItemsSource="{Binding DataContext.EngineOptions, ElementName=Root}"
                                                SelectedItem="{Binding DataContext.SelectedProfileEngineOption, ElementName=Root, Mode=TwoWay}"
                                                DisplayMemberPath="Title"
                                                HorizontalAlignment="Stretch" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Host" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Grid ColumnSpacing="8">
                                                <!-- Shares the width, so a narrow window never squeezes the host field to nothing. -->
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" MaxWidth="220" /></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileHost_TextChanged" MinWidth="120" />
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="Choose host" SelectionChanged="ProfileHostPreset_SelectionChanged">
                                                    <ComboBoxItem Content="127.0.0.1 (this PC)" Tag="127.0.0.1" />
                                                    <ComboBoxItem Content="0.0.0.0 (network)" Tag="0.0.0.0" />
                                                    <ComboBoxItem Content="localhost" Tag="localhost" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                                <NumberBox Header="Port" Value="{Binding Port, Mode=TwoWay}" ValueChanged="ProfilePort_ValueChanged" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Inline" Width="180" />
                                                <Button Content="Choose port" Click="ChooseProfilePort_Click" VerticalAlignment="Bottom" />
                                                <TextBlock x:Name="ProfilePortStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="ProfilePortNote" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox Content="Start with administrator rights" IsChecked="{Binding RunAsAdministrator, Mode=TwoWay}" />
                                        <TextBlock Text="Windows will request permission for this profile only. Other profiles stay at normal rights."
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <CheckBox Content="Open browser on start" IsChecked="{Binding OpenBrowserOnStart, Mode=TwoWay}" />
                                        <TextBox Header="Extra arguments" Text="{Binding ExtraArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Spacing="4">
                                                <TextBlock Text="Computed address" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" />
                                        </StackPanel>
                                        <ComboBox Header="Profile color" ItemsSource="{Binding DataContext.ProfileColors, ElementName=Root}"
                                                  SelectedItem="{Binding DataContext.SelectedProfileColor, ElementName=Root, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{Binding Brush}" />
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8" Visibility="{Binding DataContext.SelectedProfileRootVisibility, ElementName=Root}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Directories" FontSize="17" FontWeight="SemiBold" />
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Root folder" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding RootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1" Style="{StaticResource QuietIconButtonStyle}" Click="PickRoot_Click" AutomationProperties.Name="Choose root folder">
                                                        <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Working directory" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Empty means root folder" />
                                                    <Button Grid.Column="1" Style="{StaticResource QuietIconButtonStyle}" Click="PickWorkingDirectory_Click" AutomationProperties.Name="Choose working directory">
                                                        <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8" Visibility="{Binding DataContext.SelectedProfileNodeVisibility, ElementName=Root}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Node.js" FontSize="17" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="14" Visibility="{Binding DataContext.SelectedProfileNodeVisibility, ElementName=Root}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Entry file" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{Binding NodeEntryFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="The port and host are passed to the process through the PORT and HOST variables." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8" Visibility="{Binding DataContext.SelectedProfileCustomVisibility, ElementName=Root}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Command" FontSize="17" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="14" Visibility="{Binding DataContext.SelectedProfileCustomVisibility, ElementName=Root}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Executable" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{Binding CustomCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="For custom command engine" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="Arguments" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{Binding CustomArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="6" Visibility="{Binding DataContext.SelectedProfileCustomVisibility, ElementName=Root}">
                                            <TextBlock Text="Working directory" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
                                                <Button Grid.Column="1" Style="{StaticResource QuietIconButtonStyle}" Click="PickWorkingDirectory_Click" AutomationProperties.Name="Choose working directory">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="Arguments are parsed with quotes in mind. The PORT variable is available to the process." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Configuration files" FontWeight="SemiBold" FontSize="17" />
                                                <Button Grid.Column="1" Click="RefreshProfileConfigFiles_Click" ToolTipService.ToolTip="Refresh configuration files" AutomationProperties.Name="Refresh configuration files">
                                                    <SymbolIcon Symbol="Refresh" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="No configuration files found" Visibility="{Binding DataContext.ProfileConfigFilesEmptyVisibility, ElementName=Root}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding DataContext.ProfileConfigFilesProblem, ElementName=Root}" Visibility="{Binding DataContext.ProfileConfigFilesProblemVisibility, ElementName=Root}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding DataContext.ProfileConfigFiles, ElementName=Root}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnSpacing="8" Padding="0,5">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                                <TextBlock Text="{Binding Note}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Open" Click="OpenProfileConfigFile_Click" VerticalAlignment="Center" />
                                                            <Button Grid.Column="2" Content="Edit" Click="EditProfileConfigFile_Click" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="Starter files" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding DataContext.StarterTemplates, ElementName=Root}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="10" Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding LocalizedTitle}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Summary}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Click="CreateStarter_Click" AutomationProperties.Name="Create">
                                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                                        <TextBlock Text="Create" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8" Visibility="{Binding DataContext.SelectedProfileHttpsVisibility, ElementName=Root}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="HTTPS" FontSize="17" FontWeight="SemiBold" />
                                            <CheckBox Content="HTTPS" IsChecked="{Binding HttpsEnabled, Mode=TwoWay}" IsEnabled="{Binding SupportsHttps}" Checked="ProfileHttps_Changed" Unchecked="ProfileHttps_Changed" />
                                            <Button Content="Certificates..." Click="Certificates_Click" IsEnabled="{Binding SupportsHttps}" HorizontalAlignment="Left" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox Header="Certificate (PEM)" Text="{Binding CertificatePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfileCertificatePath_TextChanged" />
                                                <Button Grid.Column="1" Content="Browse..." Tag="certificate" Click="ChooseProfileCertificateFile_Click" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox Header="Private key (PEM)" Text="{Binding PrivateKeyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="ProfilePrivateKeyPath_TextChanged" />
                                                <Button Grid.Column="1" Content="Browse..." Tag="key" Click="ChooseProfileCertificateFile_Click" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <TextBlock x:Name="ProfileCertificateStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="MakeTrustedCertificateButton" Content="Make a trusted certificate" Click="MakeTrustedCertificate_Click" HorizontalAlignment="Left" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8" Visibility="{Binding DataContext.SelectedProfileRootVisibility, ElementName=Root}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="File permissions" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Checks site access and folders used by CMS uploads, caches and logs." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Check" Click="CheckProfilePermissions_Click" />
                                                    <Button Content="Open folder" Click="OpenProfilePermissionsFolder_Click" />
                                                </StackPanel>
                                                <TextBlock x:Name="PermissionStatus" Text="Not checked" TextWrapping="Wrap" />
                                                <TextBlock x:Name="PermissionProblems" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8" Visibility="{Binding DataContext.SelectedProfilePhpVisibility, ElementName=Root}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="PHP" FontSize="17" FontWeight="SemiBold" />
                                        <ComboBox Header="PHP version" Visibility="{Binding DataContext.SelectedProfilePhpVisibility, ElementName=Root}" ItemsSource="{Binding DataContext.PhpVersionOptions, ElementName=Root}"
                                                  DisplayMemberPath="Title" SelectedItem="{Binding DataContext.SelectedProfilePhpOption, ElementName=Root, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{Binding DataContext.SelectedProfilePhpStatus, ElementName=Root}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button Content="Install missing PHP software" Command="{Binding DataContext.PrepareProfileCommand, ElementName=Root}"
                                                    Visibility="{Binding DataContext.SelectedProfilePhpInstallVisibility, ElementName=Root}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="14" Visibility="{Binding DataContext.SelectedProfilePhpVisibility, ElementName=Root}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Header="PHP memory limit" Text="{Binding PhpMemoryLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="1" Header="Upload max filesize" Text="{Binding PhpUploadMaxFilesize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <NumberBox Grid.Column="2" Header="Max execution time" Value="{Binding PhpMaxExecutionTime, Mode=TwoWay}" Minimum="1" Maximum="86400" />
                                        </Grid>
                                        <CheckBox Content="Show PHP errors" Visibility="{Binding DataContext.SelectedProfilePhpVisibility, ElementName=Root}" IsChecked="{Binding PhpDisplayErrors, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Database" FontSize="17" FontWeight="SemiBold" />
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Database name" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional CMS database" />
                                            </StackPanel>
                                        </Grid>
                                            <CheckBox Content="This profile requires MariaDB" IsChecked="{Binding NeedsDatabase, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8" Visibility="{Binding DataContext.SelectedProfileStaticVisibility, ElementName=Root}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Serving files" FontSize="17" FontWeight="SemiBold" />
                                            <ComboBox Header="Shape" SelectedValue="{Binding ConfigPreset, Mode=TwoWay}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Files as they are" Tag="standard" />
                                                <ComboBoxItem Content="Single-page app" Tag="spa" />
                                            </ComboBox>
                                            <StackPanel Orientation="Horizontal" Spacing="18">
                                            <CheckBox Content="CORS" IsChecked="{Binding EnableCors, Mode=TwoWay}" />
                                            <CheckBox Content="Gzip" IsChecked="{Binding EnableGzip, Mode=TwoWay}" />
                                            <CheckBox Content="Directory listing" IsChecked="{Binding DirectoryListing, Mode=TwoWay}" />
                                            </StackPanel>
                                            <CheckBox Content="SPA fallback" IsChecked="{Binding SpaFallback, Mode=TwoWay}" />
                                            <NumberBox Header="Cache seconds (-1 disables cache)" Value="{Binding CacheSeconds, Mode=TwoWay}" Minimum="-1" Maximum="31536000" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Protection" FontSize="17" FontWeight="SemiBold" />
                                        <Border x:Name="NetworkExposureWarning" Visibility="Collapsed" Padding="10" CornerRadius="6" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="The address is set to 0.0.0.0 — anyone on the same network can reach the server." TextWrapping="Wrap" />
                                                <Button Content="This PC only" Click="ProfileHostLocalOnly_Click" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="A local server is usually visible only to this PC, so protection is not critical. It matters once you open access to the network or show the setup to colleagues." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Spacing="8" Visibility="{Binding DataContext.SelectedProfileStaticVisibility, ElementName=Root}">
                                            <CheckBox Content="Block dotfiles (.env, .git and similar)" IsChecked="{Binding HideDotfiles, Mode=TwoWay}" />
                                                <CheckBox Content="Basic authentication" IsChecked="{Binding BasicAuthEnabled, Mode=TwoWay}" />
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBox Header="Login" Text="{Binding BasicAuthUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding BasicAuthEnabled}" />
                                                    <PasswordBox x:Name="BasicAuthPasswordBox" Grid.Column="1" Header="Password" IsEnabled="{Binding BasicAuthEnabled}" DataContextChanged="BasicAuthPassword_DataContextChanged" PasswordChanged="BasicAuthPassword_Changed" />
                                                </Grid>
                                                <TextBlock Text="The password is stored in the local profile file. Do not use a production password." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                                <CheckBox Content="Security response headers" IsChecked="{Binding SecurityHeaders}" IsEnabled="False" />
                                                <CheckBox Content="HSTS - HTTPS only" IsChecked="{Binding HstsEnabled}" IsEnabled="False" />
                                                <TextBlock Text="This engine cannot set custom response headers. A configurable web server is required." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="http-server hides dotfiles from listings but cannot block direct requests to them. Do not put secrets in a public site folder." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding DataContext.SelectedProfileStaticVisibility, ElementName=Root}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Error pages" FontSize="17" FontWeight="SemiBold" />
                                                <CheckBox Content="Custom pages for every error code" IsChecked="{Binding CustomErrorPages}" IsEnabled="False" />
                                                <TextBlock Text="This engine serves its built-in error pages. Custom pages need a configurable web server." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Environment variables" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding EnvironmentSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Edit..." Click="EditEnvironment_Click" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12" Background="{StaticResource ServerMasterPanelSubtleBrush}" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Notes" FontSize="17" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" PlaceholderText="Notes for this profile" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Padding="28" Visibility="{Binding ProfilesEmptyVisibility}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360">
                                    <FontIcon Glyph="&#xE710;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="No profile selected" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Create a profile or choose one from the list to configure it." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="New profile" Click="NewProfile_Click" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <views:SiteFilesView Grid.Row="1" Visibility="{Binding FilesVisibility}" />

                <ScrollViewer Grid.Row="1" Visibility="{Binding BackupsVisibility}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Backups" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="Take a snapshot before you break something" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Grid.Column="1" Command="{Binding CreateAllBackupsCommand}" IsEnabled="{Binding CanSnapshotProfiles}" Content="Snapshot every profile" VerticalAlignment="Top" /></Grid>
                        <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding BackupWorkVisibility}" AutomationProperties.Name="Working on snapshots" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Message="{Binding BackupProblem}" Visibility="{Binding BackupProblemVisibility}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Automatic snapshot profiles" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ScheduledBackupProfilesSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

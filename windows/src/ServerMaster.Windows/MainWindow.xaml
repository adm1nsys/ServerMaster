                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18" Visibility="{Binding DatabaseRunningVisibility}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="These are the details you enter in the installer of Joomla, WordPress or any other CMS." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Host" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding DatabaseHost}" FontFamily="Cascadia Mono, Consolas" /><TextBlock Grid.Column="2" /></Grid>
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="115" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Port" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding DatabasePort}" FontFamily="Cascadia Mono, Consolas" /><TextBlock Grid.Column="2" /></Grid>
